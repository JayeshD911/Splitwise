# Local Secrets Configuration Template
# IMPORTANT: Do NOT commit the actual application-secrets.properties file
# This is configured in .gitignore to prevent accidental credential leaks

# Copy this file to "application-secrets.properties" in the project root
# and fill in your actual credentials:
# 	cp application-secrets.properties.example application-secrets.properties

# Database credentials
DB_USERNAME=root
DB_PASSWORD=your_actual_password

# Optional: Database host and name (if different from defaults)
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=splitwise_db

